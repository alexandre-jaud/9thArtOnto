<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ajaud02/seqartonto#"
     xml:base="http://www.semanticweb.org/ajaud02/seqartonto"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:seqartonto="http://www.semanticweb.org/ajaud02/seqartonto#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ajaud02/seqartonto">
        <terms:title xml:lang="en">9thArtOnto</terms:title>
        <rdfs:label xml:lang="en">9thArtOnto</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:comment xml:lang="en">The title of the comic book work (e.g. &quot;Asterix en Lusitanie&quot;). Used on Book individuals.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Book"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#visualFill -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#visualFill">
        <rdfs:comment xml:lang="en">The fill color (hex) used to render this concept in a knowledge graph.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#visualShape -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#visualShape">
        <rdfs:comment xml:lang="en">The SVG shape used to render this concept in a knowledge graph (e.g. rect, circle, polygon).</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#visualStroke -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#visualStroke">
        <rdfs:comment xml:lang="en">The stroke color (hex) used to render this concept in a knowledge graph.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#emittedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#emittedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:comment xml:lang="en">Links a Balloon or Caption to the Character who is its speaker, thinker, or narrative voice.</rdfs:comment>
        <rdfs:label xml:lang="en">emittedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasAgent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasAgent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links an Interaction to the entity (Character or Object) that performs the action. Non-functional: multiple agents are allowed for collective interactions (e.g. A, B and C sit together).</rdfs:comment>
        <rdfs:label xml:lang="en">hasAgent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasBalloon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasBalloon">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:comment xml:lang="en">Links a Level to the Balloons it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasBalloon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasCaption -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasCaption">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
        <rdfs:comment xml:lang="en">Links a Panel or a Plate to its Caption.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCaption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasCharacter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasCharacter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:comment xml:lang="en">Links a Level to the Character occurrences it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCharacter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasCharacterOccurrence -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasCharacterOccurrence">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#isCharacter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:comment xml:lang="en">Links a MetaCharacter to all its local Character occurrences across panels and plates.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCharacterOccurrence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasInstrument -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasInstrument">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
        <rdfs:comment xml:lang="en">Links an Interaction to an Object that plays a non-patient role, either as a tool used to perform the action (e.g. a gun, a sword) or as a passive support or spatial context (e.g. a bench being sat on, a table around which characters gather). The interactionType verb disambiguates the exact role.</rdfs:comment>
        <rdfs:label xml:lang="en">hasInstrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasInteraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasInteraction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:comment xml:lang="en">Links a Level to the Interactions it contains. An Interaction groups the participants (Characters and/or Objects) of a single action or relation occurring within the same Level.</rdfs:comment>
        <rdfs:label xml:lang="en">hasInteraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:comment xml:lang="en">Links a Panel to one or more Levels it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasLevel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasLocative -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasLocative">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
        <rdfs:comment xml:lang="en">Links an Interaction to the Object that serves as its spatial reference point. Corresponds to the locative thematic role (Fillmore 1968): the object at, near, or in relation to which the action or spatial relation takes place (e.g. a wall, a table, a door). Distinct from hasInstrument (which the agent actively uses) and from hasPatient (which undergoes the action): the locative Object is a passive spatial anchor. Optional: only annotated when a specific Object grounds the spatial dimension of the Interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">hasLocative</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasNarrativeLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasNarrativeLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation"/>
        <rdfs:comment xml:lang="en">Links a Scene to the NarrativeLocation where it takes place. Since a Scene is defined as the unit of spatial, character, and action continuity (Zwaan &amp; Radvansky 1998), location is a constitutive property of the Scene and is anchored here rather than on finer-grained constituents. Non-leaf levels inherit their location implicitly through their sub-Scenes. Inspired by GOLEM&apos;s G13_Narrative_Location.</rdfs:comment>
        <rdfs:label xml:lang="en">hasNarrativeLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasNarrativeUnit -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasNarrativeUnit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <rdfs:comment xml:lang="en">Hierarchical composition property linking a NarrativeConstituent to its direct sub-constituents within the five-level narrative tree (Story → Arc → Event → Scene → Segment). Used at every level of the hierarchy: a Story hasNarrativeUnit its Arcs, an Arc hasNarrativeUnit its Events, an Event hasNarrativeUnit its Scenes, and a Scene hasNarrativeUnit its Segments. Inspired by GOLEM&apos;s G9_Narrative_Unit mereological relation (Pianzola et al. 2025).</rdfs:comment>
        <rdfs:label xml:lang="en">hasNarrativeUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasNextPanel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasNextPanel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:comment xml:lang="en">Points to the next Panel(s) in reading order. Intentionally non-functional: certain page layouts leave the reading order partially open to the reader, so a panel may have more than one possible successor. Typically derived from hasRank, but the non-functional form allows modelling ambiguous or branching reading paths.</rdfs:comment>
        <rdfs:label xml:lang="en">hasNextPanel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasNextPlate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasNextPlate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:comment xml:lang="en">Points to the immediately following Plate in reading order. Functional: a plate has at most one successor. Asymmetric and irreflexive: a plate cannot follow itself.</rdfs:comment>
        <rdfs:label xml:lang="en">hasNextPlate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasObject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
        <rdfs:comment xml:lang="en">Links a Level to the Objects it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasObject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasObjectOccurrence -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasObjectOccurrence">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#isObject"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#MetaObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
        <rdfs:comment xml:lang="en">Links a MetaObject to all its local Object occurrences across panels.</rdfs:comment>
        <rdfs:label xml:lang="en">hasObjectOccurrence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasOnomatopoeia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasOnomatopoeia">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia"/>
        <rdfs:comment xml:lang="en">Links a Level or a Balloon to the Onomatopoeias it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasOnomatopoeia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasOrigin -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasOrigin">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links an Onomatopoeia to the Character or Object that is the source of the sound it represents (e.g. a &quot;BANG&quot; originating from a gun, a &quot;SPLASH&quot; from a character falling into water).</rdfs:comment>
        <rdfs:label xml:lang="en">hasOrigin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasPanel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasPanel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:comment xml:lang="en">Links a Plate to the Panels it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPanel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasPatient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasPatient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links an Interaction to the entity (Character or Object) that undergoes or receives the action. Absent for symmetric interactions where no participant is primarily affected (e.g. A and B kiss).</rdfs:comment>
        <rdfs:label xml:lang="en">hasPatient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasPlate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasPlate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Book"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:comment xml:lang="en">Links a Book to the Plates it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPlate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasPolypticContinuity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasPolypticContinuity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:comment xml:lang="en">Links a polyptic panel to the other panels with which it shares a continuous visual composition.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPolypticContinuity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasSceneSetting -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasSceneSetting">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#SceneSetting"/>
        <rdfs:comment xml:lang="en">Links a Level to its SceneSetting, describing the visual appearance of the environment as it is rendered in that specific panel level.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSceneSetting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasSourceEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasSourceEvent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TemporalLink"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <rdfs:comment xml:lang="en">The source NarrativeConstituent of a TemporalLink (the arc from which the temporal relation is expressed). Corresponds to the source EVENT in a TimeML TLINK.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSourceEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasSubLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasSubLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation"/>
        <rdfs:comment xml:lang="en">Links a NarrativeLocation to its spatially contained sub-locations. Enables a recursive containment hierarchy of diegetic places (e.g. &quot;Paris&quot; hasSubLocation &quot;Café de Flore&quot;). Inspired by the mereological location structure in GOLEM (Pianzola et al. 2025).</rdfs:comment>
        <rdfs:label xml:lang="en">hasSubLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasTail -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasTail">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Tail"/>
        <rdfs:comment xml:lang="en">Links a Balloon to its Tail. The absence of this relation indicates a tail-less balloon (e.g. broadcast or narrator balloon).</rdfs:comment>
        <rdfs:label xml:lang="en">hasTail</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasTargetEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasTargetEvent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TemporalLink"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <rdfs:comment xml:lang="en">The target NarrativeConstituent of a TemporalLink (the arc to which the temporal relation points). Corresponds to the related EVENT in a TimeML TLINK.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTargetEvent</rdfs:label>
    </owl:ObjectProperty>
    



    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasTextLine -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasTextLine">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:comment xml:lang="en">Links a Balloon, Caption, Level, or Plate to the TextLines it contains. A TextLine directly attached to a Level with no Balloon or Caption parent represents free text integrated into the image (e.g. text on a building facade or an object). A TextLine directly attached to a Plate represents text outside any panel, typically with a para-narrative function (e.g. titles, credits, dedications).</rdfs:comment>
        <rdfs:label xml:lang="en">hasTextLine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasTextSpan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasTextSpan">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
        <rdfs:comment xml:lang="en">Links a TextLine to the TextSpans (words or groups of words sharing the same typographic style) it contains. Multiple TextSpans within a TextLine are only justified when typographic style varies within the line.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTextSpan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasTimex -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasTimex">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Timex"/>
        <rdfs:comment xml:lang="en">Links a Caption (typically of captionType &quot;Effect&quot;, e.g. &quot;Three years later...&quot;) to a Timex instance encoding the temporal expression it contains. Corresponds to TimeML&apos;s TIMEX3 annotation (Pustejovsky et al. 2003 / ISO 24617-1).</rdfs:comment>
        <rdfs:label xml:lang="en">hasTimex</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#instantiates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#instantiates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Segment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Level"/>
        <rdfs:comment xml:lang="en">Links a Segment (leaf NarrativeConstituent) to the Level(s) of the comic that visually realise it. Only Segments carry instantiates relations directly: higher-level constituents (Scene, Event, Arc, Story) are realised indirectly through the instantiates of their descendant Segments. A Segment may instantiate multiple Levels when it spans a polymorphic panel (e.g. both Level_3a and Level_3b of the same panel instantiate the same Segment). This property bridges the narrative/discourse layer and the visual/material layer.</rdfs:comment>
        <rdfs:label xml:lang="en">instantiates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isCharacter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isCharacter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter"/>
        <rdfs:comment xml:lang="en">Links a local character occurrence (within a panel or plate) to the meta-character it represents.</rdfs:comment>
        <rdfs:label xml:lang="en">isCharacter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isObject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#MetaObject"/>
        <rdfs:comment xml:lang="en">Links a local object occurrence (within a panel) to the meta-object it represents.</rdfs:comment>
        <rdfs:label xml:lang="en">isObject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#linkedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#linkedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:comment xml:lang="en">Links two Balloons that form a multi-balloon group (i.e. a single utterance split across several connected bubbles). Balloons linked this way typically share no individual tail. Symmetric: if A is linkedTo B, then B is linkedTo A.</rdfs:comment>
        <rdfs:label xml:lang="en">linkedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#mentions -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#mentions">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaObject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a Balloon or Caption to a MetaCharacter or MetaObject explicitly mentioned or referred to in its text content. The range targets meta-level entities (persistent referents) rather than local occurrences, since verbal references identify the entity across the story world regardless of its visual presence in the panel. Captions are included because narrator text frequently mentions absent characters or objects (e.g. &quot;And so our friends Asterix and Obelix...&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">mentions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#nextNarrativeTextLine -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#nextNarrativeTextLine">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:comment xml:lang="en">Points to the immediately following narrative TextLine in reading order within its container (Balloon or Caption). Only applies to TextLines of type &quot;narrative&quot;; diegetic and paratextual lines are excluded. Functional: a TextLine has at most one successor.</rdfs:comment>
        <rdfs:label xml:lang="en">nextNarrativeTextLine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#realizesLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#realizesLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#SceneSetting"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation"/>
        <rdfs:comment xml:lang="en">Links a SceneSetting (visual instance in a Level) to the NarrativeLocation (diegetic concept) it visually realises. Mirrors the isInstanceOf relation between Character and MetaCharacter.</rdfs:comment>
        <rdfs:label xml:lang="en">realizesLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#atmosphericLayer -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#atmosphericLayer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Describes a visual effect or atmospheric element that overlays the entire plate and is perceived first by the reader (e.g. &quot;snow&quot;, &quot;fog&quot;, &quot;rain&quot;, &quot;dust&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">atmosphericLayer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#backgroundColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#backgroundColor">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The background color of a balloon or caption box, encoded as a hex code (e.g. &quot;#FFFF00&quot;) or a color name (e.g. &quot;yellow&quot;). On a Balloon, this is used when the balloon fill differs from the default white, for instance a black background for a villain&apos;s speech, or a coloured fill conveying a particular emotional tone.</rdfs:comment>
        <rdfs:label xml:lang="en">backgroundColor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#balloonType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#balloonType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>broadcast</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>exclamation</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>speech</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>thought</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>whisper</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The narrative role of the balloon. Allowed values: &quot;speech&quot; (standard spoken dialogue), &quot;thought&quot; (internal monologue or thought), &quot;exclamation&quot; (strong emotional outburst or shout), &quot;whisper&quot; (low-voice or confidential speech), &quot;broadcast&quot; (off-panel voice, narrator, or off-screen broadcast such as a radio or telephone).</rdfs:comment>
        <rdfs:label xml:lang="en">balloonType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#borderPoints -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#borderPoints">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The polygon boundary of the element as an ordered list of 2D points, encoded as a space-separated string of &quot;x,y&quot; pairs (SVG polygon format). Example: &quot;10,20 50,20 50,80 10,80&quot;. Coordinates are expressed in pixels relative to the plate origin.</rdfs:comment>
        <rdfs:label xml:lang="en">borderPoints</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#borderStyle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#borderStyle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>smooth</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>wavy</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>zigzag</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The stroke style of the balloon border. Allowed values: &quot;smooth&quot; (plain continuous line, standard speech), &quot;wavy&quot; (undulating line, typically used for thoughts or fear), &quot;zigzag&quot; (jagged line, typically used to express anger or shouting).</rdfs:comment>
        <rdfs:label xml:lang="en">borderStyle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#borderType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#borderType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>frameless</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>full-fenced</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>half-closed</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Describes the border style of the panel. Allowed values: &quot;full-fenced&quot; (fully enclosed by borders), &quot;half-closed&quot; (partially bordered), &quot;frameless&quot; (no visible border).</rdfs:comment>
        <rdfs:label xml:lang="en">borderType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#captionType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#captionType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Caption"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Effect</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Internal</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Narrative</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The enunciative role of the caption. Allowed values: &quot;Narrative&quot; (voice of an external narrator commenting or introducing an action from outside the fiction, e.g. &quot;And so our friends set off once more on a long journey…&quot;), &quot;Effect&quot; (atmospheric, temporal, or situational indication, e.g. &quot;The next morning…&quot;), &quot;Internal&quot; (inner monologue of a character expressed as a caption, e.g. &quot;Those words were engraved in my heart…&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">captionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#category -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#category">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>ambient-emotion</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>animal-sound</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>creaking</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>cry</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>human-emotion</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>human-noise</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first>impact-explosion</rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first>nature-sound</rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                        <rdf:first>symbol</rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                <rdf:first>technological-sound</rdf:first>
                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The sound category of the onomatopoeia. Allowed values: Human: &quot;cry&quot;, &quot;human-noise&quot;, &quot;human-emotion&quot;; Object: &quot;impact-explosion&quot;, &quot;creaking&quot;, &quot;technological-sound&quot;; Miscellaneous: &quot;animal-sound&quot;, &quot;nature-sound&quot;, &quot;ambient-emotion&quot;; Pictogram: &quot;symbol&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#closureState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#closureState">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>closed</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>unclosed</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates whether the balloon boundary is fully drawn or partially open. Allowed values: &quot;closed&quot; (enclosed by a continuous border), &quot;unclosed&quot; (open or half-open, blending partially into the background).</rdfs:comment>
        <rdfs:label xml:lang="en">closureState</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#content -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#content">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The textual content of a TextSpan (word or group of words within a TextLine sharing a typographic style) or an Onomatopoeia (e.g. &quot;BANG&quot;, &quot;SPLASH&quot;). Content is anchored at the finest granularity level.</rdfs:comment>
        <rdfs:label xml:lang="en">content</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#description -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#description">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#SceneSetting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A free-text description of the visual appearance of the environment as seen in this Level (e.g. &quot;Dense foggy forest at night&quot;, &quot;Sun-lit clearing with tall grass&quot;). Captures the local visual rendering of the NarrativeLocation without imposing a controlled vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#emotion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#emotion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>afraid</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>alarmed</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>angry</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>annoyed</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>aroused</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>astonished</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first>at ease</rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first>bored</rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                        <rdf:first>calm</rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                <rdf:first>content</rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                        <rdf:first>delighted</rdf:first>
                                                                                                        <rdf:rest>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                <rdf:first>depressed</rdf:first>
                                                                                                                <rdf:rest>
                                                                                                                    <rdf:Description>
                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                        <rdf:first>distressed</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                            <rdf:Description>
                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                <rdf:first>droopy</rdf:first>
                                                                                                                                <rdf:rest>
                                                                                                                                    <rdf:Description>
                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                        <rdf:first>excited</rdf:first>
                                                                                                                                        <rdf:rest>
                                                                                                                                            <rdf:Description>
                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                <rdf:first>frustrated</rdf:first>
                                                                                                                                                <rdf:rest>
                                                                                                                                                    <rdf:Description>
                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                        <rdf:first>glad</rdf:first>
                                                                                                                                                        <rdf:rest>
                                                                                                                                                            <rdf:Description>
                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                <rdf:first>gloomy</rdf:first>
                                                                                                                                                                <rdf:rest>
                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                        <rdf:first>happy</rdf:first>
                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                            <rdf:Description>
                                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                <rdf:first>miserable</rdf:first>
                                                                                                                                                                                <rdf:rest>
                                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                        <rdf:first>pleased</rdf:first>
                                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                                            <rdf:Description>
                                                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                <rdf:first>relaxed</rdf:first>
                                                                                                                                                                                                <rdf:rest>
                                                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                        <rdf:first>sad</rdf:first>
                                                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                                                            <rdf:Description>
                                                                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                                <rdf:first>satisfied</rdf:first>
                                                                                                                                                                                                                <rdf:rest>
                                                                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                                        <rdf:first>serene</rdf:first>
                                                                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                                                                            <rdf:Description>
                                                                                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                                                <rdf:first>sleepy</rdf:first>
                                                                                                                                                                                                                                <rdf:rest>
                                                                                                                                                                                                                                    <rdf:Description>
                                                                                                                                                                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                                                        <rdf:first>tense</rdf:first>
                                                                                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                                                                                            <rdf:Description>
                                                                                                                                                                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                                                                                                                                                                <rdf:first>tired</rdf:first>
                                                                                                                                                                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                                                                                                                            </rdf:Description>
                                                                                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                                                                                </rdf:rest>
                                                                                                                                                                                                                            </rdf:Description>
                                                                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                                                                </rdf:rest>
                                                                                                                                                                                                            </rdf:Description>
                                                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                                                </rdf:rest>
                                                                                                                                                                                            </rdf:Description>
                                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                                </rdf:rest>
                                                                                                                                                                            </rdf:Description>
                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                    </rdf:Description>
                                                                                                                                                                </rdf:rest>
                                                                                                                                                            </rdf:Description>
                                                                                                                                                        </rdf:rest>
                                                                                                                                                    </rdf:Description>
                                                                                                                                                </rdf:rest>
                                                                                                                                            </rdf:Description>
                                                                                                                                        </rdf:rest>
                                                                                                                                    </rdf:Description>
                                                                                                                                </rdf:rest>
                                                                                                                            </rdf:Description>
                                                                                                                        </rdf:rest>
                                                                                                                    </rdf:Description>
                                                                                                                </rdf:rest>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:rest>
                                                                                                    </rdf:Description>
                                                                                                </rdf:rest>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The emotion expressed by the character within this panel occurrence. Allowed values are the 28 affect terms from Russell&apos;s circumplex model of affect (Russell 1980): &quot;afraid&quot;, &quot;alarmed&quot;, &quot;angry&quot;, &quot;annoyed&quot;, &quot;aroused&quot;, &quot;astonished&quot;, &quot;at ease&quot;, &quot;bored&quot;, &quot;calm&quot;, &quot;content&quot;, &quot;delighted&quot;, &quot;depressed&quot;, &quot;distressed&quot;, &quot;droopy&quot;, &quot;excited&quot;, &quot;frustrated&quot;, &quot;glad&quot;, &quot;gloomy&quot;, &quot;happy&quot;, &quot;miserable&quot;, &quot;pleased&quot;, &quot;relaxed&quot;, &quot;sad&quot;, &quot;satisfied&quot;, &quot;serene&quot;, &quot;sleepy&quot;, &quot;tense&quot;, &quot;tired&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">emotion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#graphicStyle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#graphicStyle">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Book"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Describes the graphic style. On a Book, it characterises the overall visual style of the work (e.g. &quot;ligne claire&quot;, &quot;expressionist&quot;, &quot;realistic&quot;, &quot;cartoonish&quot;). On a Panel, it is used only when the panel departs from the dominant style of the book, for instance to signal a dream sequence, a flashback rendered differently, or a deliberate stylistic shift (e.g. &quot;watercolour insert&quot;, &quot;sketchy&quot;, &quot;black-and-white within colour album&quot;). Panels that follow the book&apos;s default style should leave this property absent.</rdfs:comment>
        <rdfs:label xml:lang="en">graphicStyle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The sequential number of the plate within the book.</rdfs:comment>
        <rdfs:label xml:lang="en">hasNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#hasRank -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#hasRank">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">The position of the Panel in the canonical reading sequence within its Plate (1-based). The next panel can be derived from hasRank: panel P2 follows P1 if P2 has rank n+1 and both share the same Plate.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRank</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#height -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#height">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">The height of the plate in pixels. Defines the vertical extent of the spatial reference frame within which the borderPoints of all contained panels are expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#interactionType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#interactionType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Interaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Describes the nature of the interaction as a verb in infinitive form or a spatial relation (e.g. &quot;shoot&quot;, &quot;kiss&quot;, &quot;sit-on&quot;, &quot;carry&quot;). Also disambiguates the role of hasInstrument participants (tool vs. spatial support).</rdfs:comment>
        <rdfs:label xml:lang="en">interactionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isBold -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isBold">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the span is rendered in bold. Bold text within a line typically signals emphasis, stress, or increased vocal intensity.</rdfs:comment>
        <rdfs:label xml:lang="en">isBold</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isItalic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isItalic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the span is rendered in italic. Italic text within a line typically signals a foreign word, a title, a whisper, or a particular vocal inflection.</rdfs:comment>
        <rdfs:label xml:lang="en">isItalic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#textColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#textColor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The color of the text in this span, encoded as a CSS hex color string (e.g. &quot;#FF0000&quot; for red). Color variation within a line can signal emphasis, character identity, or supernatural/magical connotations.</rdfs:comment>
        <rdfs:label xml:lang="en">textColor</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/ajaud02/seqartonto#textEffect -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#textEffect">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A free-text description of any visual effect or decoration applied to this span beyond basic typographic style (e.g. &quot;yellow circle&quot;, &quot;red underline&quot;, &quot;drop shadow&quot;, &quot;outlined&quot;). Intended for graphical embellishments that cannot be expressed by isBold, isItalic, or textColor alone.</rdfs:comment>
        <rdfs:label xml:lang="en">textEffect</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isLocative -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isLocative">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the panel is a locative panel, i.e. a purely establishing shot that sets the spatial context of a scene. Rather than depicting an action or advancing the narrative in time, it implicitly signals to the reader where the events of the following panels take place.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocative</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isPolychronic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isPolychronic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the panel contains two or more layers, each corresponding to a distinct time window (T). For example, the foreground may represent the present while the background depicts a flashback, thus embedding multiple temporal moments within a single panel.</rdfs:comment>
        <rdfs:label xml:lang="en">isPolychronic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.semanticweb.org/ajaud02/exemple/polychronicPanel.png"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isPolymorphic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isPolymorphic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the panel is a polymorphic panel (also known as a stroboscopic panel), i.e. a single panel in which the same character or entity is drawn multiple times in different positions to depict the unfolding of an action.</rdfs:comment>
        <rdfs:label xml:lang="en">isPolymorphic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#isPolyptic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#isPolyptic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the panel is part of a polyptic composition, i.e. a panel whose image extends across adjacent panels to form a single continuous visual composition spanning multiple panels.</rdfs:comment>
        <rdfs:label xml:lang="en">isPolyptic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#locationName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#locationName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the diegetic location (e.g. &quot;Paris&quot;, &quot;The Forbidden Forest&quot;, &quot;Café de Flore&quot;). Free text, as location names in fictional worlds are not necessarily grounded in real-world gazetteers.</rdfs:comment>
        <rdfs:label xml:lang="en">locationName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaObject"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of a meta-character, meta-object, or object occurrence as referred to in the narrative (e.g. &quot;Asterix&quot;, &quot;Excalibur&quot;, &quot;guitar&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#narrativeEvent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#narrativeEvent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A free-text description of the narrative event (story-world action, state, or transition) represented by this constituent. Captures the semantic content of what happens at this level of the narrative arc, independently of how it is distributed across panels. Inspired by GOLEM&apos;s G5_Narrative_Event (Meghini et al. 2021) and Chen&apos;s (2025) event-based hierarchical framework. A leaf constituent may describe a single action (e.g. &quot;The detective picks up the clue&quot;), while a higher-level constituent describes the macro-event it subsumes (e.g. &quot;The detective discovers the truth&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">narrativeEvent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#narrativeRole -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#narrativeRole">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Segment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Establisher</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Initial</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Peak</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>Refiner</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>Release</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The narrative role of this NarrativeConstituent within its parent arc, following Cohn&apos;s Visual Narrative Grammar (2020). Functional: each constituent bears exactly one role. The value is constrained to the following enumeration: &quot;Establisher&quot; (E): sets the scene without advancing the action; &quot;Initial&quot; (I): initiates the narrative tension; &quot;Peak&quot; (P): the climactic moment that heads the constituent and determines its role at the level above; &quot;Release&quot; (R): resolves the tension after a Peak; &quot;Refiner&quot; (r): elaborates or modifies an adjacent element without independent narrative force. The role is relative to the constituent&apos;s position within its parent: a sub-constituent with role &quot;Peak&quot; is what makes the parent itself a &quot;Peak&quot; at the next level up (recursive heading).</rdfs:comment>
        <rdfs:label xml:lang="en">narrativeRole</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#onDoublePage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#onDoublePage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the plate spans a double page (true) or a single page (false).</rdfs:comment>
        <rdfs:label xml:lang="en">onDoublePage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#panelTransition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#panelTransition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Panel"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>action-to-action</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>aspect-to-aspect</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>moment-to-moment</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>non-sequitur</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>scene-to-scene</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>subject-to-subject</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The type of temporal/spatial transition between this Panel and the next one in reading order (McCloud, 1993). Values: &quot;moment-to-moment&quot; (successive instants of a single action), &quot;action-to-action&quot; (a single subject performing distinct actions), &quot;subject-to-subject&quot; (different subjects within a single scene), &quot;scene-to-scene&quot; (significant temporal or spatial jump), &quot;aspect-to-aspect&quot; (different aspects of the same place, idea or mood, no time progression), &quot;non-sequitur&quot; (no logical or narrative relation). Applies to the source panel of the nextPanel relation.</rdfs:comment>
        <rdfs:label xml:lang="en">panelTransition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#rightToLeft -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#rightToLeft">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Book"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the book is read from right to left (true) or left to right (false). A value of true typically characterises manga and other East Asian comics, while a value of false corresponds to Western comics (bandes dessinées, American comics, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">rightToLeft</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#shape -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#shape">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Balloon"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>cloud</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>oval</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>peak</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>rectangle</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>suggested</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The overall shape of the balloon. Allowed values: &quot;oval&quot; (standard elliptical bubble), &quot;rectangle&quot; (rectangular bubble), &quot;cloud&quot; (cloud-shaped, typically used for thoughts), &quot;peak&quot; (spiky/explosion shape, typically used for shouts), &quot;suggested&quot; (implied boundary, not fully drawn).</rdfs:comment>
        <rdfs:label xml:lang="en">shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#tailDirection -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#tailDirection">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Tail"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>E</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>N</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>NE</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>NW</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>S</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>SE</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first>SW</rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first>W</rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                        <rdf:first>none</rdf:first>
                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The cardinal direction in which the balloon tail points, relative to the balloon body. Allowed values: &quot;N&quot;, &quot;NE&quot;, &quot;E&quot;, &quot;SE&quot;, &quot;S&quot;, &quot;SW&quot;, &quot;W&quot;, &quot;NW&quot;, &quot;none&quot; (tail-less balloon).</rdfs:comment>
        <rdfs:label xml:lang="en">tailDirection</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#tailTip -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#tailTip">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Tail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The exact coordinates of the tip of the balloon tail, encoded as a single &quot;x,y&quot; pair (e.g. &quot;142,87&quot;). Coordinates are expressed in pixels relative to the plate origin, consistent with the borderPoints convention.</rdfs:comment>
        <rdfs:label xml:lang="en">tailTip</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#textLineType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#textLineType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>diegetic</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>narrative</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>paratext</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The functional role of the text line within the plate. Allowed values: &quot;narrative&quot; (text anchored in the discourse, such as speech or thought in a Balloon, narration or description in a Caption); &quot;diegetic&quot; (text that exists as a visual inscription within the represented world, e.g. text on a building facade, a road sign, an open letter or newspaper); &quot;paratext&quot; (editorial text outside the diegesis, e.g. title, page number, credits, legal notices, or any information printed in the margins of the plate, in the Genettian sense).</rdfs:comment>
        <rdfs:label xml:lang="en">textLineType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#textOrientation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#textOrientation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TextLine"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>horizontal</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>vertical</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The physical orientation of the text line on the plate. Allowed values: &quot;horizontal&quot; (text runs left-to-right or right-to-left along the horizontal axis, as in most Western and manga layouts) or &quot;vertical&quot; (text runs top-to-bottom along the vertical axis, as in traditional East Asian comics). When absent, horizontal orientation is assumed.</rdfs:comment>
        <rdfs:label xml:lang="en">textOrientation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#timexText -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#timexText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Timex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The original text of the temporal expression as it appears in the caption (e.g. &quot;Three years later&quot;, &quot;The next morning&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">timexText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#timexType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#timexType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Timex"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>DATE</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>DURATION</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>SET</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>TIME</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The type of temporal expression, following TimeML&apos;s TIMEX3 typology (ISO 24617-1): DATE (calendar date), TIME (time of day), DURATION (elapsed time, e.g. &quot;three years&quot;), SET (recurring expressions, e.g. &quot;every morning&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">timexType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#timexValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#timexValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Timex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The normalized ISO 8601 value of the temporal expression (e.g. &quot;P3Y&quot; for &quot;three years&quot;, &quot;1944&quot; for a year reference). Optional when normalization is not possible.</rdfs:comment>
        <rdfs:label xml:lang="en">timexValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#tlinkType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#tlinkType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#TemporalLink"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>BEFORE</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>IDENTITY</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>SIMULTANEOUS</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The type of temporal relation between the source and target NarrativeConstituents, following TimeML (Pustejovsky et al. 2003): BEFORE (source ends before target begins in the story world, e.g. a flashback), SIMULTANEOUS (source and target co-occur in the story world, e.g. parallel narration), IDENTITY (source and target refer to the same story-world event seen from two different narrative positions).</rdfs:comment>
        <rdfs:label xml:lang="en">tlinkType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#visible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#visible">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the character is graphically represented within the panel (true) or is diegetically present but off-panel (false). A value of false allows modelling off-field characters whose presence is inferred from contextual cues, such as a speech balloon with no visible speaker, or a character whose presence is logically deduced from other visual elements (e.g. a taxi implying a driver). Attaching invisible characters to a Level ensures the knowledge graph reflects the actual narrative structure, not only its visible content.</rdfs:comment>
        <rdfs:label xml:lang="en">visible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#width -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#width">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#Plate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">The width of the plate in pixels. Defines the horizontal extent of the spatial reference frame within which the borderPoints of all contained panels are expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Arc -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Arc">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <visualFill>#3D006E</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">An Arc is a major narrative division of a Story, grouping a set of Events united by a shared narrative thread, dramatic tension, or thematic continuity. Unlike an editorial chapter (a physical division of the book), an Arc is defined purely by narrative coherence. An Arc is composed of one or more Events via hasNarrativeUnit.</rdfs:comment>
        <rdfs:label xml:lang="en">Arc</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Balloon -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Balloon">
        <visualFill>#90D5FF</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Balloon is a graphic area containing the text that transcribes speech, thoughts, or narration. It serves as a visual interface between the text and the speaking character, to whom it is generally connected by a tail. Furthermore, the shape of the bubble and the style of its outline (smooth, wavy, jagged) convey important narrative information about the emotional state or tone of voice of the speaker.</rdfs:comment>
        <rdfs:label xml:lang="en">Balloon</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Book -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Book">
        <visualFill>#4169E1</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Book is a comic book work as a whole, serving as the top-level container for all its plates. It corresponds to a complete published album or volume, identified by its title.</rdfs:comment>
        <rdfs:label xml:lang="en">Book</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Caption -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Caption">
        <visualFill>#ffadf2</visualFill>
        <visualShape>rect</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Caption is a graphic element, generally rectangular in shape, with no directional arrow, often placed in the corners of a panel. Unlike conventional speech bubbles, it is used to include narrative text, such as the voice of an omniscient narrator (caption box) serving to situate the action in space and time, or the voice-over of a character recounting their memories.</rdfs:comment>
        <rdfs:label xml:lang="en">Caption</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Character -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Character">
        <visualFill>#FF0000</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Character is the local representation of a MetaCharacter within a panel or a plate. It constitutes the visual and contextual instantiation of that MetaCharacter at a specific moment in the narrative, embedded within a particular spatial and temporal frame. A single MetaCharacter may thus be represented by multiple Characters across different panels or plates, each potentially varying in appearance, posture, expression, or scale depending on the artistic choices of the author.</rdfs:comment>
        <rdfs:label xml:lang="en">Character</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <visualFill>#6A0DAD</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">An Event is a NarrativeConstituent that unifies a set of Scenes around a single dramatic question, understood as a causal or intentional thread that persists across changes of location and protagonist cast. An Event opens with an unresolved tension and closes when that tension is resolved or abandoned. Grounded in the causal and intentional dimensions of the Event-Indexing Model (Zwaan &amp; Radvansky 1998) and event segmentation theory (Zacks &amp; Tversky 2001). Corresponds to the macro-event level of Chen (2025). An Event is composed of one or more Scenes via hasNarrativeUnit.</rdfs:comment>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Interaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Interaction">
        <visualFill>#FF8C00</visualFill>
        <visualShape>triangle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">An Interaction is a direct action or relation between participants (Characters or Objects) within the same Level. It is characterised by its type (interactionType), one or more agents (hasAgent), an optional patient (hasPatient), and an optional instrument or support object (hasInstrument).</rdfs:comment>
        <rdfs:label xml:lang="en">Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Level -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Level">
        <visualFill>#ff6600</visualFill>
        <visualShape>rect</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Level is the finest-grained content unit within a Panel. It represents the visual and narrative content of the panel as perceived within a single, coherent time window (T). In the standard case, a panel contains exactly one Level, which groups all the characters, objects, balloons, onomatopoeias, and free text present in the scene at that moment. When a panel depicts several distinct temporal moments simultaneously — a polychronic panel (isPolychronic = true) — it is decomposed into multiple Levels, each corresponding to a different time window: for instance, a foreground showing the present action and a background depicting a simultaneous or past event.</rdfs:comment>
        <rdfs:label xml:lang="en">Level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaCharacter">
        <visualFill>#FF00FF</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A MetaCharacter is a persistent actor of the story, identified across all its occurrences in the work. It is not necessarily human and can take many forms, such as an animal, a robot, or an object. Drawn with complete artistic freedom, it very often exhibits significant deformations or disproportions that distance it from real-world proportions. To distinguish it from a background element, its active narrative function is the primary criterion: a true MetaCharacter has a direct influence on the story, which is generally manifested by uttering at least one speech bubble.</rdfs:comment>
        <rdfs:label xml:lang="en">MetaCharacter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#MetaObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#MetaObject">
        <visualFill>#FFFE00</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A MetaObject is a named, narratively significant object that recurs across panels or plates and can be identified as a persistent entity in the story world (e.g. a weapon, a vehicle, a symbolic artefact). It serves as the abstract referent of which local Object occurrences within panels are instantiations.</rdfs:comment>
        <rdfs:label xml:lang="en">MetaObject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent">
        <visualFill>#6A0DAD</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">Abstract superclass of all narrative units in 9thArtOnto. A NarrativeConstituent represents a coherent grouping of narrative content at one of five levels of abstraction, forming a strict tree: Story → Arc → Event → Scene → Segment. The hierarchy integrates three theoretical frameworks: (1) the editorial/structural level (Story, Arc) groups events by narrative coherence rather than by physical book division; (2) the cognitive level (Event, Scene) is grounded in the Event-Indexing Model (Zwaan &amp; Radvansky 1998) and event segmentation theory (Zacks &amp; Tversky 2001); (3) the visual-grammatical level (Segment) corresponds to the VNG constituent (Arc) of Cohn (2013), the only level that directly realises Levels via instantiates and bears a narrativeRole (Establisher, Initial, Peak, Release, Refiner). Location (hasNarrativeLocation) is anchored at the Scene level, as a Scene is defined by spatial, character, and action continuity. Non-leaf levels (Story, Arc, Event, Scene) are realised indirectly through their descendant Segments. Composition is navigated uniformly via hasNarrativeUnit at every level of the hierarchy. Inspired by Cohn (2013, 2020), GOLEM&apos;s G9_Narrative_Unit (Pianzola et al. 2025), and Chen&apos;s (2025) hierarchical event framework.</rdfs:comment>
        <rdfs:label xml:lang="en">NarrativeConstituent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeLocation">
        <visualFill>#2E8B57</visualFill>
        <visualShape>hexagon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A NarrativeLocation represents the diegetic place where narrative events occur. It is the story-world concept of a location, independent of how it is visually rendered in any specific panel. NarrativeLocations form a recursive containment hierarchy via hasSubLocation (e.g. &quot;Paris&quot; contains &quot;Café de Flore&quot;). A single NarrativeLocation instance can be referenced by multiple leaf NarrativeConstituents, providing identity persistence across panels without requiring a separate MetaLocation class. Inspired by GOLEM&apos;s G13_Narrative_Location (Pianzola et al. 2025).</rdfs:comment>
        <rdfs:label xml:lang="en">NarrativeLocation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Object -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Object">
        <visualFill>#FFBF00</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">An Object is a physical or tangible entity present within a panel that enters into interaction with one or more characters. Unlike background elements, an Object plays an active role in the scene by being manipulated, wielded, or otherwise engaged with by a character.</rdfs:comment>
        <rdfs:label xml:lang="en">Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Onomatopoeia">
        <visualFill>#296a2b</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">An Onomatopoeia is a word designed to phonetically imitate the natural sounds associated with the objects or actions it describes. In comics, it is graphically integrated into the image in a wide variety of shapes, colours, and orientations to visually represent those sounds. As a genuine narrative device, it bridges the gap between text and image to heighten the reader&apos;s immersion and the emotional impact of a scene.</rdfs:comment>
        <rdfs:label xml:lang="en">Onomatopoeia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Panel -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Panel">
        <visualFill>#ffffff</visualFill>
        <visualShape>rect</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Panel is an image area within a comic plate that illustrates a single action or scene. Although traditionally considered as a rectangle bounded by borders, new definitions describe it as a free-shape polygon encompassing the entirety of its visual content. Arranged sequentially, panels can sometimes be frameless, overlap each other, or adopt a wide variety of shapes.</rdfs:comment>
        <rdfs:label xml:lang="en">Panel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Plate -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Plate">
        <visualFill>#FF6347</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Plate is the plane or space on which the different panels of a comic strip are spatially juxtaposed and ordered to tell a story. In a classic printed work, it generally materializes as a page (or even a double page) of an album.</rdfs:comment>
        <rdfs:label xml:lang="en">Plate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Scene -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Scene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <visualFill>#9B30FF</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Scene is a NarrativeConstituent defined by the simultaneous stability of two perceptually detectable dimensions: spatial (same NarrativeLocation) and character (same set of protagonists). Following the Event-Indexing Model (Zwaan &amp; Radvansky 1998; Zwaan, Magliano &amp; Graesser 1995), a new Scene begins whenever one of these dimensions shifts significantly: a change of location or a significant change in the protagonist cast. The causal and intentional dimensions of the EIM are delegated to the Event level, which groups Scenes around a shared dramatic question. The Scene bears the hasNarrativeLocation link and is composed of one or more Segments via hasNarrativeUnit.</rdfs:comment>
        <rdfs:label xml:lang="en">Scene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#SceneSetting -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#SceneSetting">
        <visualFill>#90EE90</visualFill>
        <visualShape>hexagon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A SceneSetting captures the visual appearance of the environment as it is rendered in a specific Level. It is the visual instance of a NarrativeLocation: while a NarrativeLocation is the diegetic concept (&quot;the forest&quot;), a SceneSetting describes how that location looks in a particular panel level (&quot;dense foggy forest at night&quot;). Anchored on Level (via hasSceneSetting) and linked to its corresponding NarrativeLocation (via realizesLocation). Mirrors the MetaCharacter/Character pattern for identity persistence vs. local visual description.</rdfs:comment>
        <rdfs:label xml:lang="en">SceneSetting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Segment -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Segment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <visualFill>#C76BFF</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Segment is the leaf NarrativeConstituent in the narrative hierarchy. It corresponds to a VNG constituent (Arc) in the sense of Cohn (2013): a grouping of one or more Levels that together bear a single narrative role (Establisher, Initial, Peak, Release, or Refiner) relative to the parent Scene. The Segment is the only level that directly instantiates Levels (via instantiates) and the only level that carries a narrativeRole value. Higher levels (Scene, Event, Arc, Story) are realised indirectly through their descendant Segments. APPLICABILITY WARNING: narrativeRole should only be annotated when the visual track carries the narrative autonomously. As Cohn (2015) cautions: &quot;not all sequences of images use the principles of VNG. In particular, narrative sequences used in multimodal contexts (i.e., combining text and image) may not have a clear-cut narrative structure, due to the meaning being distributed into both text and image. […] The structures of VNG appear most strongly in wordless visual narratives.&quot; A practical diagnostic: if deleting the text causes the visuals to lose their overall gist, narrativeRole should be left unassigned on this Segment.</rdfs:comment>
        <rdfs:label xml:lang="en">Segment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Story -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Story">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ajaud02/seqartonto#NarrativeConstituent"/>
        <visualFill>#1A0040</visualFill>
        <visualShape>polygon</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A Story is the top-level NarrativeConstituent representing the complete narrative content of a comic work (the fabula in its entirety). It is the narrative counterpart of a Book: while a Book is the physical artefact, a Story is the abstract sequence of events it conveys. A Story is composed of one or more Arcs via hasNarrativeUnit.</rdfs:comment>
        <rdfs:label xml:lang="en">Story</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Tail -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Tail">
        <visualFill>#4682B4</visualFill>
        <visualShape>triangle</visualShape>
        <visualStroke>#1A1A2E</visualStroke>
        <rdfs:comment xml:lang="en">A Tail is the graphical appendage of a Balloon that visually connects it to its speaker. It is characterised by its direction (tailDirection) and the coordinates of its tip (tailTip). A Balloon without a Tail denotes a broadcast, off-panel, or narrator voice.</rdfs:comment>
        <rdfs:label xml:lang="en">Tail</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#TemporalLink -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TemporalLink">
        <visualFill>#FF8C00</visualFill>
        <visualShape>diamond</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A reified temporal relation between two NarrativeConstituents, expressing how their story-world intervals relate according to Allen&apos;s interval algebra (Allen 1983). Only instantiated when the fabula order differs from or complexifies the syuzhet order: flashbacks (BEFORE/AFTER), flash-forwards (AFTER), and parallel narration (SIMULTANEOUS). The default case (consecutive constituents in both reading and story order) requires no TemporalLink.</rdfs:comment>
        <rdfs:label xml:lang="en">TemporalLink</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#TextLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TextLine">
        <visualFill>#808080</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A TextLine represents a single physical line of text as it appears on the plate. It allows fine-grained annotation of text independently of its container. A TextLine may be contained in a Balloon, a Caption, or a FreeText element (e.g. text on the facade of a building or an object); containers link to their TextLines via hasTextLine. A TextLine is further decomposed into one or more TextSpans via hasTextSpan, only when typographic style varies within the line.</rdfs:comment>
        <rdfs:label xml:lang="en">TextLine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#TextSpan -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#TextSpan">
        <visualFill>#D3D3D3</visualFill>
        <visualShape>circle</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A TextSpan represents a word or group of words within a TextLine that share a uniform typographic style. This level of granularity is justified by the fact that typographic style can vary within a single line, as a word rendered in bold, italic, or all-caps carries its own meaning and may signal emphasis, vocal stress, or a change of register. Multiple TextSpans within a TextLine are only warranted when there is actual stylistic variation; a stylistically homogeneous line maps to a single TextSpan.</rdfs:comment>
        <rdfs:label xml:lang="en">TextSpan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ajaud02/seqartonto#Timex -->

    <owl:Class rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Timex">
        <visualFill>#FFD700</visualFill>
        <visualShape>diamond</visualShape>
        <visualStroke>#000000</visualStroke>
        <rdfs:comment xml:lang="en">A temporal expression found in a Caption (typically captionType &quot;Effect&quot;), such as &quot;Three years later&quot; or &quot;The next morning&quot;. Corresponds to TimeML&apos;s TIMEX3 annotation standard (ISO 24617-1). Carries the original text (timexText), the expression type (timexType: DATE, TIME, DURATION, SET), and optionally a normalized ISO 8601 value (timexValue).</rdfs:comment>
        <rdfs:label xml:lang="en">Timex</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Arc"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Event"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Scene"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Segment"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/ajaud02/seqartonto#Story"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



